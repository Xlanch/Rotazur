# ==============================================================================
# ROTA PLANLAYICISI - ORTAM DEĞİŞKENLERİ (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANLI UÇAK BİLETİ VE OTEL API'LERİ (GERÇEK ZAMANLI PİYASA VERİSİ)
# ------------------------------------------------------------------------------
# Anahtar tanımlanması ilgili sağlayıcıya istek göndermeyi etkinleştirir.
# Bu sağlayıcıların ticari kullanım, kota ve aşım ücretleri hesap planınıza bağlıdır.
# Ücret istemiyorsanız aşağıdaki isteğe bağlı anahtarları boş bırakın.
# Hava: MET Norway (CC BY 4.0); döviz: ExchangeRate-API Open Access.
# Bunlar anahtar veya ücretli abonelik gerektirmez; kaynak bağlantıları arayüzde yer alır.

# A) RapidAPI - Skyscanner Uçuş API'si (En popüler Skyscanner alternatifi)
# Kayıt: https://rapidapi.com — abonelik ve aşım koşullarını hesabınızdan kontrol edin.
# Key: 'x-rapidapi-key' değerini buraya yapıştırın.
RAPIDAPI_KEY=

# B) Amadeus for Developers (test ve ticari üretim koşulları farklı olabilir)
# Kayıt: https://developers.amadeus.com -> Ücretsiz hesap açın, "My Self-Service Workspace" -> "Create App"
# Size verilen Client ID ve Client Secret bilgilerini buraya yazın:
AMADEUS_CLIENT_ID=YOUR_AMADEUS_CLIENT_ID_HERE
AMADEUS_CLIENT_SECRET=

# C) Tequila by Kiwi.com (erişim ve ticari koşullar sağlayıcıya bağlıdır)
# Kayıt: https://tequila.kiwi.com
KIWI_API_KEY=

# D) SerpApi (Google Flights & Google Hotels; hesap kotası ve ücretleri geçerlidir)
# Kayıt: https://serpapi.com -> Dashboard'dan API Key alın:
SERPAPI_KEY=

# Booking arama sonuçlarını SerpApi üzerinden almak için (Booking Demand API değildir):
# Ücretsiz hesap kotası sınırlıdır; otomatik ücretli yükseltme yapılmaz.
# Anahtar ve bu seçim olmadan gerçek Booking sonucu gösterilmez.
# Uygulama içindeki tüm SerpApi aramaları toplam 45/saat ve 200/son 31 gün ile sınırlıdır.
# Aynı anahtarın başka uygulamalardaki kullanımı bu sayaca dahil değildir.
HOTEL_PRICE_PROVIDER=booking-serpapi
# Yalnızca Booking tarafından size verilmiş gerçek affiliate ID; Travelpayouts marker yazmayın.
BOOKING_AFFILIATE_ID=


# ------------------------------------------------------------------------------
# 2. GMAIL İLE GERÇEK E-POSTA GÖNDERİMİ (ÖNERİLEN)
# ------------------------------------------------------------------------------
# Gmail hesabınızdan güvenli "Uygulama Şifresi" (App Password) alıp buraya yazabilirsiniz:
# Adımlar:
# 1) Google Hesabım -> Güvenlik -> "2 Adımlı Doğrulama"yı açın.
# 2) "Uygulama Şifreleri" (App Passwords) sekmesine girip yeni bir şifre üretin (16 haneli).
# 3) Aşağıdaki alanlara e-posta ve 16 haneli uygulama şifresini yazın:
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 3. VEYA ÖZEL KURUMSAL SMTP BİLGİLERİ (İsteğe Bağlı)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ornek@gmail.com
# SMTP_PASS=sifreniz
# SMTP_FROM=destek@rotaplanlayici.com

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI (Yapay Zeka Destekli Kişiselleştirilmiş İpuçları İçin)
# ------------------------------------------------------------------------------
# Kayıt: https://aistudio.google.com -> API Key
GEMINI_API_KEY=

# Günlük fiyat motoru: anahtar yalnızca sunucuda tutulur.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Ücretsiz Aviasales Data API dışında uçuş sağlayıcısına otomatik geçiş yapma.
# Gösterge fiyatıdır; biletin güncel müsaitliğini veya grup fiyatını doğrulamaz.
FLIGHT_PRICE_PROVIDER=travelpayouts-data

# HTTP üzerinden zorunlu senkronizasyon için en az 32 karakterlik gizli değer.
# Authorization: Bearer <SYNC_SECRET> başlığıyla kullanılır; tarayıcıya aktarılmaz.
SYNC_SECRET=

# Yalnızca güvenilir ters vekil arkasında çalışıyorsanız vekil sayısını belirtin.
# 0: istemcinin gönderebildiği X-Forwarded-For başlığına güvenilmez.
# Örn. tek güvenilir vekil için 1; doğrudan yayın için 0 bırakın.
TRUST_PROXY_HOPS=0
